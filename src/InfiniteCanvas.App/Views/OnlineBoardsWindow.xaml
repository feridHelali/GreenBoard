<Window x:Class="InfiniteCanvas.App.Views.OnlineBoardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mes tableaux en ligne" Width="700" Height="450"
        WindowStartupLocation="CenterOwner" Background="White" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}"/>
    </Window.Resources>

    <Border Padding="20,16,20,16">
        <StackPanel>
            <!-- En-tête -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconPage}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Mes tableaux en ligne" Style="{StaticResource DialogTitle}"/>
                    <TextBlock Style="{StaticResource DialogHint}" Text="Vos tableaux stockés dans votre espace GreenBoard Cloud."/>
                </StackPanel>
            </StackPanel>

            <!-- Liste des documents -->
            <ListBox x:Name="DocumentsList" Height="260" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionMode="Single" BorderBrush="#D1D5DB" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Style="{StaticResource DialogHint}" FontSize="11">
                                        <Run Text="{Binding PageCount}"/> page(s) · <Run Text="{Binding SizeBytes, StringFormat='{}{0:N0} octets'}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ModifiedAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                           Style="{StaticResource DialogHint}" FontSize="11" Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="Ouvrir" Style="{StaticResource DialogButtonStyle}"
                                        Margin="8,0,0,0" Padding="10,4" Click="Open_Click" Tag="{Binding}"/>
                                <Button Grid.Column="3" Content="×" Style="{StaticResource DialogButtonStyle}"
                                        Margin="4,0,0,0" Padding="4" FontWeight="Bold" Foreground="#D93025"
                                        Click="Delete_Click" Tag="{Binding}" ToolTip="Supprimer"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Message vide -->
            <TextBlock x:Name="EmptyMessage" Style="{StaticResource DialogHint}" Margin="0,12,0,0"
                       Visibility="Collapsed">Aucun tableau enregistré.</TextBlock>

            <!-- Actions -->
            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Fermer" Style="{StaticResource DialogButtonStyle}" IsCancel="True"/>
                <Button DockPanel.Dock="Right" Content="Fermer la session" Style="{StaticResource DialogButtonStyle}"
                        Click="Logout_Click" Margin="0,0,8,0"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
