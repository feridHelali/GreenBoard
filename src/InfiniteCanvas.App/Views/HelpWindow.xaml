<Window x:Class="InfiniteCanvas.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aide — GreenBoard" Width="820" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" FontSize="13">
    <Window.Resources>
        <!-- Bloc de code à copier (configuration d'un assistant IA) -->
        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8,46,8" />
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,2,0" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="ToolTip" Value="Copier" />
        </Style>
        <!-- Onglets verticaux à gauche -->
        <Style TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" CornerRadius="8" Padding="12,9" Margin="0,0,0,4" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="Icon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                              Stroke="{StaticResource IconBrush}" StrokeThickness="1.9"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter x:Name="Text" ContentSource="Header" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="#3C4350"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Text" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Barre latérale (identité, onglets, Fermer) dessinée par le modèle du TabControl ; Tag = version -->
    <TabControl x:Name="Tabs" BorderThickness="0" Padding="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#F7F8FA" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                        <DockPanel Margin="14,18,14,16">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,18">
                                <Image Source="/Assets/GreenBoard.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="GreenBoard" FontWeight="SemiBold" FontSize="15" Foreground="#1F2937"/>
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource DialogHint}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button DockPanel.Dock="Bottom" Content="Fermer" Style="{StaticResource DialogButtonStyle}" Margin="0"
                                    IsCancel="True" Click="Close_Click"/>
                            <StackPanel IsItemsHost="True"/>
                        </DockPanel>
                    </Border>
                    <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
            <!-- Fonctionnalités -->
            <TabItem Header="Fonctionnalités" Tag="{StaticResource IconPen}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,24,22">
                    <StackPanel>
                        <TextBlock Text="Fonctionnalités" Style="{StaticResource DialogTitle}"/>
                        <TextBlock Style="{StaticResource DialogHint}" Margin="0,4,0,4"
                                   Text="Un tableau infini pour préparer et animer vos cours, au stylet, à la souris ou au doigt."/>
                        <StackPanel x:Name="FeaturesPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Assistant IA (serveur MCP) -->
            <TabItem x:Name="AssistantTab" Header="Assistant IA" Tag="{StaticResource IconSparkle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,24,22">
                    <StackPanel>
                        <TextBlock Text="Connecter un assistant IA" Style="{StaticResource DialogTitle}"/>
                        <TextBlock Style="{StaticResource DialogHint}" Margin="0,4,0,0" FontSize="13"
                                   Text="Claude (ou tout assistant compatible MCP) dessine des illustrations de cours directement sur le tableau ouvert : schémas, figures, circuits, cartes… Vous décrivez, il dessine, vous annotez."/>

                        <!-- État de l'installation -->
                        <Border x:Name="McpStatus" Margin="0,14,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1">
                            <DockPanel>
                                <TextBlock x:Name="McpStatusIcon" DockPanel.Dock="Left" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="McpStatusText" TextWrapping="Wrap" Foreground="#1F2937"/>
                            </DockPanel>
                        </Border>

                        <!-- Étape 1 : choisir son assistant (un bloc à copier par client MCP) -->
                        <TextBlock Text="1 · Brancher votre assistant (une seule fois)" Style="{StaticResource DialogSection}"/>

                        <TextBlock Text="Claude Desktop" FontWeight="SemiBold" Foreground="#1F2937"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" Margin="0,2,0,0">
                            <Run FontWeight="SemiBold" Text="Paramètres › Développeur › Modifier la configuration"/>, collez ce bloc dans
                            <Run FontFamily="Consolas" Text="claude_desktop_config.json"/> (ou ajoutez l'entrée « greenboard » à vos
                            « mcpServers »), enregistrez puis redémarrez Claude Desktop :
                        </TextBlock>
                        <Grid Margin="0,6,0,0">
                            <TextBox x:Name="DesktopConfig" Style="{StaticResource CodeBox}"/>
                            <Button Content="{StaticResource IconCopy}" Style="{StaticResource CopyButton}" Tag="{Binding ElementName=DesktopConfig}" Click="Copy_Click"/>
                        </Grid>

                        <TextBlock Text="Claude Code (terminal)" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,14,0,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" Margin="0,2,0,0" Text="Dans un terminal :"/>
                        <Grid Margin="0,6,0,0">
                            <TextBox x:Name="CodeCommand" Style="{StaticResource CodeBox}" TextWrapping="Wrap"/>
                            <Button Content="{StaticResource IconCopy}" Style="{StaticResource CopyButton}" Tag="{Binding ElementName=CodeCommand}" Click="Copy_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="OpenCode" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="gratuit et libre" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" Margin="0,2,0,0">
                            Agent open source (opencode.ai), utilisable avec des modèles gratuits ou locaux. Ajoutez ce bloc à
                            <Run FontFamily="Consolas" Text="%USERPROFILE%\.config\opencode\opencode.json"/> (ou à un
                            <Run FontFamily="Consolas" Text="opencode.json"/> dans votre dossier de travail) :
                        </TextBlock>
                        <Grid Margin="0,6,0,0">
                            <TextBox x:Name="OpenCodeConfig" Style="{StaticResource CodeBox}"/>
                            <Button Content="{StaticResource IconCopy}" Style="{StaticResource CopyButton}" Tag="{Binding ElementName=OpenCodeConfig}" Click="Copy_Click"/>
                        </Grid>

                        <TextBlock Text="Autre assistant compatible MCP" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,14,0,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" Margin="0,2,0,0">
                            Cursor, VS Code (Copilot), Continue, Cline, LM Studio… : déclarez un serveur MCP de type
                            <Run FontWeight="SemiBold" Text="stdio"/>, sans argument, avec cette commande :
                        </TextBlock>
                        <Grid Margin="0,6,0,0">
                            <TextBox x:Name="McpCommand" Style="{StaticResource CodeBox}" TextWrapping="Wrap"/>
                            <Button Content="{StaticResource IconCopy}" Style="{StaticResource CopyButton}" Tag="{Binding ElementName=McpCommand}" Click="Copy_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                                   Text="La qualité des illustrations dépend du modèle : il doit savoir écrire du SVG soigné. Les grands modèles récents donnent les meilleurs résultats ; un petit modèle local fera des schémas plus simples."/>

                        <!-- Étape 2 : utilisation -->
                        <TextBlock Text="2 · Demander une illustration" Style="{StaticResource DialogSection}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#374151" LineHeight="20">
                            <Run Text="• Gardez GreenBoard ouvert : le dessin arrive sur la page active, à un endroit libre."/><LineBreak/>
                            <Run Text="• L'assistant vérifie son dessin avant de le poser ; demandez-lui ensuite de le corriger ou de le compléter."/><LineBreak/>
                            <Run Text="• Il peut aussi créer une page, changer l'arrière-plan ou retirer une illustration."/><LineBreak/>
                            <Run Text="• Dans Claude Desktop, le modèle de demande « illustration_cours » guide la conversation."/><LineBreak/>
                            <Run Text="• L'illustration est une image : déplacez-la avec l'outil Sélection (V) et annotez-la au stylet."/>
                        </TextBlock>

                        <!-- 10 demandes types -->
                        <TextBlock Text="10 demandes types, à copier-coller" Style="{StaticResource DialogSection}"/>
                        <StackPanel x:Name="PromptsPanel"/>
                        <TextBlock x:Name="CopiedHint" Style="{StaticResource DialogHint}" Margin="0,8,0,0" Visibility="Hidden"
                                   Text="Copié dans le presse-papiers."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Raccourcis -->
            <TabItem x:Name="ShortcutsTab" Header="Raccourcis clavier" Tag="{StaticResource IconKeyboard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,24,22">
                    <StackPanel>
                        <TextBlock Text="Raccourcis clavier" Style="{StaticResource DialogTitle}"/>
                        <TextBlock Style="{StaticResource DialogHint}" Margin="0,4,0,4"
                                   Text="Les lettres seules choisissent un outil ; elles sont ignorées pendant la saisie d'un titre de page."/>
                        <StackPanel x:Name="ShortcutsPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- À propos -->
            <TabItem x:Name="AboutTab" Header="À propos" Tag="{StaticResource IconInfo}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,24,22">
                    <StackPanel>
                        <!-- Application -->
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/GreenBoard.png" Width="76" Height="76" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GreenBoard" FontSize="26" FontWeight="SemiBold" Foreground="#1F2937"/>
                                <TextBlock x:Name="AboutVersion" Foreground="#3C4350" FontSize="14"/>
                                <TextBlock Text="Tableau blanc infini pour l'enseignement" Style="{StaticResource DialogHint}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Auteur -->
                        <Border Margin="0,22,0,0" Padding="18" CornerRadius="12" Background="#F7F8FA"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="112" Height="112" VerticalAlignment="Top">
                                    <Ellipse Fill="{StaticResource AccentSoftBrush}"/>
                                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="3">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="/Assets/Auteur.png" Stretch="UniformToFill"
                                                        Viewbox="0.12,0.03,0.76,0.58" ViewboxUnits="RelativeToBoundingBox"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="20,4,0,0">
                                    <TextBlock Text="AUTEUR" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                    <TextBlock Text="Ferid HELALI" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,2,0,0"/>
                                    <TextBlock Foreground="#3C4350" Margin="0,2,0,0">
                                        <Run Text="avec"/> <Run Text="Claude Code" FontWeight="SemiBold"/> <Run Text="(Anthropic), assistant de programmation"/>
                                    </TextBlock>
                                    <TextBlock Text="ÉDITEUR" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,16,0,6"/>
                                    <Image Source="/Assets/AlfaComputers.png" Width="200" HorizontalAlignment="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Alfa Computers Apps" Foreground="#3C4350" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Détails -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Version" Foreground="#6B7280"/>
                            <TextBlock x:Name="DetailVersion" Grid.Column="1" Foreground="#1F2937"/>
                            <TextBlock Grid.Row="1" Text="Technologie" Foreground="#6B7280"/>
                            <TextBlock x:Name="DetailRuntime" Grid.Row="1" Grid.Column="1" Foreground="#1F2937"/>
                            <TextBlock Grid.Row="2" Text="Code source" Foreground="#6B7280"/>
                            <TextBlock Grid.Row="2" Grid.Column="1">
                                <Hyperlink x:Name="RepoLink" Click="Link_Click" Foreground="{StaticResource AccentBrush}"><Run x:Name="RepoText"/></Hyperlink>
                            </TextBlock>
                            <TextBlock Grid.Row="3" Text="Réglages" Foreground="#6B7280"/>
                            <TextBlock x:Name="DetailSettings" Grid.Row="3" Grid.Column="1" Foreground="#1F2937" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <TextBlock x:Name="CopyrightText" Style="{StaticResource DialogHint}" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
    </TabControl>
</Window>
