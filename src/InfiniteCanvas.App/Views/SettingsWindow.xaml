<Window x:Class="InfiniteCanvas.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réglages — GreenBoard" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" FontSize="13">
    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3C4350" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Width" Value="64" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Border Padding="24,20,24,20">
        <StackPanel>
            <!-- En-tête -->
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconGear}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Réglages" Style="{StaticResource DialogTitle}"/>
                    <TextBlock Style="{StaticResource DialogHint}" Text="Appliqués immédiatement, conservés pour les prochaines sessions."/>
                </StackPanel>
            </StackPanel>

            <!-- Stylet -->
            <TextBlock Text="Stylet et formes" Style="{StaticResource DialogSection}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="2" Text="Taille du texte" Style="{StaticResource RowLabel}"/>
                <Slider x:Name="TextSlider" Grid.Row="2" Grid.Column="1" Minimum="12" Maximum="120" TickFrequency="2" IsSnapToTickEnabled="True"
                        ValueChanged="Any_Changed"/>
                <TextBlock x:Name="TextValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}"/>
                <TextBlock Text="Épaisseur du stylet" Style="{StaticResource RowLabel}"/>
                <Slider x:Name="PenSlider" Grid.Column="1" Minimum="1" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        ValueChanged="Any_Changed"/>
                <TextBlock x:Name="PenValue" Grid.Column="2" Style="{StaticResource Value}"/>

                <TextBlock Grid.Row="1" Text="Épaisseur des formes" Style="{StaticResource RowLabel}"/>
                <Slider x:Name="ShapeSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        ValueChanged="Any_Changed"/>
                <TextBlock x:Name="ShapeValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"/>
            </Grid>
            <!-- Aperçu du trait -->
            <Border Height="46" Margin="0,6,0,0" CornerRadius="8" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1">
                <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
            </Border>
            <CheckBox x:Name="SmoothingBox" Content="Lisser le tracé (courbes de Bézier)" Checked="Any_Changed" Unchecked="Any_Changed"/>
            <CheckBox x:Name="PressureBox" Content="Sensibilité à la pression (tablette graphique, stylet)" Checked="Any_Changed" Unchecked="Any_Changed"/>

            <!-- Tableau -->
            <TextBlock Text="Tableau" Style="{StaticResource DialogSection}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Arrière-plan par défaut" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="BackgroundCombo" Grid.Column="1" Grid.ColumnSpan="2" Height="28" VerticalContentAlignment="Center"
                          SelectionChanged="Any_Changed"/>

                <TextBlock Grid.Row="1" Text="Vitesse du zoom (molette)" Style="{StaticResource RowLabel}"/>
                <Slider x:Name="ZoomSlider" Grid.Row="1" Grid.Column="1" Minimum="1.02" Maximum="1.5" TickFrequency="0.02" IsSnapToTickEnabled="True"
                        ValueChanged="Any_Changed"/>
                <TextBlock x:Name="ZoomValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"/>
            </Grid>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,2,0,0"
                       Text="L'arrière-plan par défaut s'applique aux nouveaux tableaux (Ctrl N). Chaque page garde le sien."/>

            <!-- Comportement -->
            <TextBlock Text="Comportement" Style="{StaticResource DialogSection}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sauvegarde automatique" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="AutoSaveCombo" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                          SelectionChanged="Any_Changed"/>
            </Grid>
            <TextBlock Style="{StaticResource DialogHint}" Margin="0,4,0,0"
                       Text="Enregistre en silence un tableau qui a déjà un fichier (.gboard)."/>
            <CheckBox x:Name="ConfirmClearBox" Content="Demander confirmation avant « Tout effacer »" Checked="Any_Changed" Unchecked="Any_Changed"/>

            <!-- Assistant IA -->
            <TextBlock Text="Assistant IA" Style="{StaticResource DialogSection}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Connecter un assistant…" Style="{StaticResource DialogButtonStyle}"
                        Click="ConnectAssistant_Click"/>
                <TextBlock Style="{StaticResource DialogHint}" VerticalAlignment="Center"
                           Text="Claude, OpenCode (gratuit) ou tout assistant MCP peut dessiner vos illustrations de cours sur le tableau."/>
            </DockPanel>

            <!-- Actions -->
            <DockPanel Margin="0,24,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Valeurs par défaut" Style="{StaticResource DialogButtonStyle}" Margin="0"
                        Click="Defaults_Click"/>
                <Button DockPanel.Dock="Right" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Click="Save_Click"/>
                <Button DockPanel.Dock="Right" Content="Annuler" Style="{StaticResource DialogButtonStyle}" IsCancel="True"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
