<Window x:Class="InfiniteCanvas.App.Views.LicenceKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clé de licence GreenBoard" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" FontSize="13">
    <Border Padding="24,20,24,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Clé de licence" Style="{StaticResource DialogTitle}"/>
                    <TextBlock Style="{StaticResource DialogHint}" Text="Entrez votre clé de licence pour activer GreenBoard."/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Clé" Margin="0,16,0,4" Style="{StaticResource RowLabel}"/>
            <TextBox x:Name="KeyBox" Margin="0,0,0,12"
                     Text="GB----- ----- ----- -----"
                     Foreground="#9CA3AF"
                     GotFocus="KeyBox_GotFocus"
                     LostFocus="KeyBox_LostFocus"
                     PreviewTextInput="KeyBox_PreviewTextInput"
                     MaxLength="29"/>

            <TextBlock x:Name="FormatHint" Style="{StaticResource DialogHint}"
                       Text="Format : GB-XXXXX-XXXXX-XXXXX-XXXXX (O, 0, I, L non utilisés)" Margin="0,0,0,16"/>

            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Activer" Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Click="Ok_Click" TabIndex="0"/>
                <Button DockPanel.Dock="Right" Content="Mode démo (30 jours)" Style="{StaticResource DialogButtonStyle}"
                        Click="Demo_Click" Margin="0,0,8,0" TabIndex="1"/>
                <Button DockPanel.Dock="Right" Content="Quitter" Style="{StaticResource DialogButtonStyle}" IsCancel="True" TabIndex="2"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
