<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\InfiniteCanvas.Core\InfiniteCanvas.Core.csproj" />
    <ProjectReference Include="..\InfiniteCanvas.Infrastructure\InfiniteCanvas.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Identité de l'application : exécutable GreenBoard.exe (l'espace de noms reste InfiniteCanvas.App) -->
    <AssemblyName>GreenBoard</AssemblyName>
    <RootNamespace>InfiniteCanvas.App</RootNamespace>
    <ApplicationIcon>Assets\GreenBoard.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>GreenBoard</Product>
    <Company>Alfa Computers Apps</Company>
    <Authors>Ferid HELALI + Claude Code</Authors>
    <Description>GreenBoard — tableau blanc infini pour l'enseignement</Description>
    <Copyright>© 2026 Ferid HELALI — Alfa Computers Apps</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icône aussi utilisée par les fenêtres (barre de titre, barre des tâches) -->
    <Resource Include="Assets\GreenBoard.ico" />
    <!-- Logo de la barre d'outils -->
    <Resource Include="Assets\GreenBoard.png" />
    <!-- Fenêtre « À propos » -->
    <Resource Include="Assets\AlfaComputers.png" />
    <Resource Include="Assets\Auteur.png" />
    <!-- Écran de démarrage (généré par installer\make-icon.ps1, affiché par App.OnStartup) -->
    <Resource Include="Assets\Splash.png" />
  </ItemGroup>

</Project>
