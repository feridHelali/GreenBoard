            <PathGeometry x:Key="IconArrow" Figures="M5,19 L19,5 M10.5,5 L19,5 L19,13.5"/>
            <PathGeometry x:Key="IconBackground" Figures="M5,4 L19,4 C19.6,4 20,4.4 20,5 L20,19 C20,19.6 19.6,20 19,20 L5,20 C4.4,20 4,19.6 4,19 L4,5 C4,4.4 4.4,4 5,4 Z M4,9.3 L20,9.3 M4,14.7 L20,14.7 M9.3,4 L9.3,20 M14.7,4 L14.7,20"/>
