            <PathGeometry x:Key="IconShare" Figures="M4,6 L20,6 C20.6,6 21,6.4 21,7 L21,17 C21,17.6 20.6,18 20,18 L4,18 C3.4,18 3,17.6 3,17 L3,7 C3,6.4 3.4,6 4,6 Z M3.5,7 L12,13 L20.5,7"/>
