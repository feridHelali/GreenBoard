            <!-- Palette commune de la barre d'outils -->
            <SolidColorBrush x:Key="IconBrush" Color="#3C4350"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#2E7D32"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3F2E5"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F4"/>
            <SolidColorBrush x:Key="PressedBrush" Color="#E2E6EA"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#E2E5EA"/>

            <!-- Séparateur vertical entre les groupes d'outils -->
            <Style x:Key="ToolbarDivider" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="Fill" Value="{StaticResource DividerBrush}" />
            </Style>

            <!-- Outil (bouton radio) : le Content est une Geometry d'icône -->
            <Style x:Key="ToggleButtonStyle" TargetType="RadioButton">
                <Setter Property="GroupName" Value="Outils" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root" Width="38" Height="38" CornerRadius="8"
                                    Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="Icon"
                                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                              Stroke="{StaticResource IconBrush}" StrokeThickness="1.9"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Action ponctuelle (bouton classique ou bascule) avec icône -->
            <Style x:Key="IconButtonStyle" TargetType="ButtonBase">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="Root" Width="38" Height="38" CornerRadius="8"
                                    Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="Icon"
                                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                              Stroke="{StaticResource IconBrush}" StrokeThickness="1.9"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource PressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Variante bascule (ouvre le choix d'arrière-plan) -->
            <Style x:Key="IconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource IconButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Petit bouton « × » des onglets de page (Content = géométrie d'icône) -->
            <Style x:Key="TabCloseButtonStyle" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Width="20" Height="20" CornerRadius="5" Background="{TemplateBinding Background}">
                                <Viewbox Width="10" Height="10">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="Icon"
                                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                              Stroke="#6B7280" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#D9DDE3" />
                                    <Setter TargetName="Icon" Property="Stroke" Value="#1F2937" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pastille de couleur du stylet (Background = couleur) -->
            <Style x:Key="ColorSwatchStyle" TargetType="RadioButton">
                <Setter Property="GroupName" Value="Couleurs" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Width="30" Height="30" Background="Transparent">
                                <Ellipse x:Name="Ring" Width="28" Height="28" Stroke="Transparent" StrokeThickness="2" />
                                <Ellipse Width="19" Height="19" Fill="{TemplateBinding Background}"
                                         Stroke="#33000000" StrokeThickness="1" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="#C9CED6" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Bouton flottant rond (réglages / aide, en bas à gauche de la zone de dessin) -->
            <Style x:Key="FloatingButtonStyle" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Width="42" Height="42" CornerRadius="21" Background="White"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="Icon" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                              Stroke="{StaticResource IconBrush}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource PressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fenêtres de dialogue (Réglages, Aide, À propos) -->
            <Style x:Key="DialogTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#1F2937" />
            </Style>
            <Style x:Key="DialogSection" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Margin" Value="0,18,0,6" />
            </Style>
            <Style x:Key="DialogHint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#6B7280" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DialogButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="#1F2937" />
                <Setter Property="BorderBrush" Value="#D1D5DB" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <!-- Touche de clavier (aide) -->
            <Style x:Key="KeyCap" TargetType="Border">
                <Setter Property="Background" Value="#F3F4F6" />
                <Setter Property="BorderBrush" Value="#D1D5DB" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="TextElement.FontFamily" Value="Consolas" />
                <Setter Property="TextElement.FontSize" Value="12" />
