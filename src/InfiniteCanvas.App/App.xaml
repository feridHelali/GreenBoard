            <PathGeometry x:Key="IconSave" Figures="M5,4 L16,4 L20,8 L20,19 C20,19.6 19.6,20 19,20 L5,20 C4.4,20 4,19.6 4,19 L4,5 C4,4.4 4.4,4 5,4 Z M8,4 L8,9 L15,9 L15,4 M7.5,20 L7.5,14 L16.5,14 L16.5,20"/>
