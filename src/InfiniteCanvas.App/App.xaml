            <PathGeometry x:Key="IconFit" Figures="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15 M10.5,12 A1.5,1.5 0 1 1 13.5,12 A1.5,1.5 0 1 1 10.5,12 Z"/>
            <PathGeometry x:Key="IconClear" Figures="M4,7 L20,7 M9.5,7 L9.5,4.5 L14.5,4.5 L14.5,7 M6,7 L7,19.5 C7.1,20.3 7.6,20.5 8.2,20.5 L15.8,20.5 C16.4,20.5 16.9,20.3 17,19.5 L18,7 M10,11 L10,16.5 M14,11 L14,16.5"/>
            <PathGeometry x:Key="IconNew" Figures="M6,4 C6,3.4 6.4,3 7,3 L14,3 L19,8 L19,20 C19,20.6 18.6,21 18,21 L7,21 C6.4,21 6,20.6 6,20 Z M14,3 L14,8 L19,8 M12.5,11.5 L12.5,17.5 M9.5,14.5 L15.5,14.5"/>
